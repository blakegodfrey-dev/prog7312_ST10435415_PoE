{
  "Attachments": {
    "StoragePath": "uploads/sensor-attachments"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LiveTelemetry": {
    "RecentHistoryCapacity": 2000
  },
  "Operations": {
    "QueueCapacity": 5000,
    "StaleSeconds": 30,
    "DisconnectedSeconds": 90,
    "ScanSeconds": 5,
    "ProcessingDelayMilliseconds": 0,
    "AllowFaultInjection": false
  }
}
